{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.2",
    "wp": "7.1"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "ai"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "wpai_features_enabled": "1",
        "wpai_feature_smoke-experiment_enabled": "1",
        "wpai_feature_suggest-reply_enabled": "1",
        "wpai_feature_custom-abilities_enabled": "0"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\nwp_set_current_user( 1 );\nwpai_skill_smoke_record_state( 'disabled' );"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "wpai_feature_custom-abilities_enabled": "1"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire '/wordpress/wp-load.php';\nwp_set_current_user( 1 );\nwpai_skill_smoke_record_state( 'enabled' );"
    }
  ]
}
